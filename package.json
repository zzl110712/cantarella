{
  "name": "cantarella",
  "version": "1.0.1",
  "description": "批量压缩图片的命令行工具",
  "type": "module",
  "bin": {
    "cantarella": "dist/bin/cli.js"
  },
  "scripts": {
    "start": "node --conditions=development bin/cli.ts --help",
    "typecheck": "tsc",
    "build": "tsc -p tsconfig.build.json && node scripts/minify.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzl110712/cantarella.git"
  },
  "author": "LeoZhao",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/zzl110712/cantarella/issues"
  },
  "homepage": "https://github.com/zzl110712/cantarella#readme",
  "keywords": [
    "image",
    "compress",
    "compression",
    "cli",
    "sharp",
    "webp",
    "avif",
    "jpeg",
    "png",
    "batch",
    "image-optimization"
  ],
  "files": [
    "dist"
  ],
  "imports": {
    "#config": {
      "development": "./config.ts",
      "default": "./dist/config.js"
    },
    "#lib/*": {
      "development": "./lib/*.ts",
      "default": "./dist/lib/*.js"
    },
    "#pkg": {
      "development": "./package.json",
      "default": "./package.json"
    }
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "p-limit": "^7.3.1",
    "sharp": "^0.35.4"
  }
}
